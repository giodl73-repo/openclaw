{
  "name": "@openclaw/lkg",
  "version": "0.1.0",
  "description": "OpenClaw lkg-recovery PR-1 prototype: LKGStore / LKGTracker<TParsed, TIssue> contract types + reference filesystem-backed impl + config-LKG migration. Bin: `openclaw-cage` (lobster-themed; the cage holds your good states until you need to fall back).",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openclaw-cage": "./bin/openclaw-cage.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-sdk": {
      "types": "./dist/plugin-sdk/lkg/index.d.ts",
      "import": "./dist/plugin-sdk/lkg/index.js"
    },
    "./fs": {
      "types": "./dist/extensions/lkg-fs/index.d.ts",
      "import": "./dist/extensions/lkg-fs/index.js"
    },
    "./test-harness": {
      "types": "./dist/test-harness/index.d.ts",
      "import": "./dist/test-harness/index.js"
    },
    "./trackers": {
      "types": "./dist/trackers/index.d.ts",
      "import": "./dist/trackers/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./lint-rules-starter": {
      "types": "./dist/extensions/lkg-lint-rules-starter/index.d.ts",
      "import": "./dist/extensions/lkg-lint-rules-starter/index.js"
    },
    "./doctor-fixers-starter": {
      "types": "./dist/extensions/lkg-doctor-fixers-starter/index.d.ts",
      "import": "./dist/extensions/lkg-doctor-fixers-starter/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openclaw/oc-path": "workspace:*",
    "@openclaw/oc-lint": "workspace:*",
    "@openclaw/oc-doctor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  }
}
