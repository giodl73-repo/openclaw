{
  "id": "lobster-host",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "name": "Lobster Host",
  "description": "Registers the inactive Lobster hosted-integration bundle.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "publicationRoot",
      "providerGeneration"
    ],
    "properties": {
      "publicationRoot": {
        "type": "string",
        "minLength": 1
      },
      "providerGeneration": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+#-]{0,255}$"
      }
    }
  }
}
