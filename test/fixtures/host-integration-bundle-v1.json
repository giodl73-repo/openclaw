        "source": "/plugins/example-host/openclaw.plugin.json",
        "origin": "config"
      }
    },
    {
      "owner": "provider-request",
      "kind": "credential-slot-resolver",
      "id": "example/provider-token",
      "version": "credential-slot-resolver/v1",
      "provenance": {
        "pluginId": "example-host",
        "source": "/plugins/example-host/openclaw.plugin.json",
        "origin": "config"
      }
    }
  ]
}
