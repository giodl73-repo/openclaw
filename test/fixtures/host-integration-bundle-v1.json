{
  "manifest": {
    "version": "host-integration-bundle/v1",
    "id": "example/host",
    "bundleVersion": "1.0.0",
    "contributions": [
      {
        "owner": "model-provider",
        "kind": "model-provider-adapter",
        "id": "example/provider-adapter",
        "version": "example-provider-adapter/v1",
        "required": true,
        "readinessCriteria": ["example.provider.ready"]
      },
      {
        "owner": "provider-request",
        "kind": "credential-slot-resolver",
        "id": "example/provider-token",
