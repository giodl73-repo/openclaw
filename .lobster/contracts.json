  "contracts": [
    {
      "id": "XPK-001",
      "title": "Shared-result ownership and dependency map",
      "dependsOn": [],
      "ownerPath": "#/sharedResults",
      "acceptedArtifact": "Every shared result has one producer and named consumers",
      "structuredFailure": "duplicate producer, missing producer, or unnamed consumer"
    },
    {
      "id": "XPK-002",
      "title": "Opaque relationship references",
      "dependsOn": ["XPK-001"],
      "ownerPath": "#/relationshipReferences",
      "acceptedArtifact": "Stable payload-neutral references preserve owner-native semantics",
      "structuredFailure": "missing reference class, duplicate reference, or payload ownership claim"
    },
    {
      "id": "XPK-003",
      "title": "Evidence integrity and disclosure",
      "dependsOn": ["XPK-001", "XPK-002"],
      "ownerPath": "#/evidenceIntegrity",
      "acceptedArtifact": "Integrity, chronology, disclosure, retention, supersession, and sink failure are explicit",
      "structuredFailure": "unverifiable evidence, ambiguous terminal class, or silent sink loss"
    },
    {
      "id": "XPK-004",
      "title": "Managed mutation request and result",
      "dependsOn": ["XPK-001", "XPK-002", "XPK-003"],
      "ownerPath": "#/managedMutation",
      "acceptedArtifact": "One operation identity binds preview, authority, owner mutation, and settlement",
      "structuredFailure": "target drift, generation conflict, replay ambiguity, or unsanitized error"
    },
    {
      "id": "XPK-005",
      "title": "Deployment and risk profiles",
      "dependsOn": ["XPK-001", "XPK-003"],
      "ownerPath": "#/deploymentProfiles",
      "acceptedArtifact": "Each profile declares dependency, risk posture, degraded behavior, and measurable budgets",
      "structuredFailure": "implicit managed dependency, permissive protected effect, or unowned budget"
    },
    {
      "id": "XPK-006",
      "title": "Implementation selection and cutover",
      "dependsOn": ["XPK-001", "XPK-002", "XPK-005"],
      "ownerPath": "#/implementationSelection",
      "acceptedArtifact": "Desired placement and authoritative local selection remain distinct",
      "structuredFailure": "multiple authorities, effectful shadow, or unknown rollback settlement"
    },
    {
      "id": "XPK-007",
      "title": "Fixture registry",
      "dependsOn": ["XPK-001", "XPK-002", "XPK-003"],
      "ownerPath": "#/fixtureRegistry",
      "acceptedArtifact": "Fixtures have stable identity, owner oracle, compatibility rules, and runner expectations",
      "structuredFailure": "unstable fixture identity, missing owner oracle, or absent structured failure"
    },
    {
      "id": "XPK-008",
      "title": "Artifact, release, and startup trust order",
      "dependsOn": ["XPK-002", "XPK-003", "XPK-005"],
      "ownerPath": "#/trustOrder",
      "acceptedArtifact": "Immutable bytes verify before parse, activation, exposure, and readiness",
      "structuredFailure": "parse-before-verify, policy-after-activation, or unpublished-byte proof"
    },
    {
      "id": "XPK-009",
      "title": "Fork, release, and deletion ledger",
      "dependsOn": ["XPK-001", "XPK-006", "XPK-008"],
      "ownerPath": "#/ledger",
      "acceptedArtifact": "Every B1, B2, or B3 path names replacement, rollback, expiry, and exact deletion",
      "structuredFailure": "unowned patch, missing replacement, indefinite carry, or unverifiable deletion"
    }
  ],
